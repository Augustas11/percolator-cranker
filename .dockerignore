# deploy/Dockerfile context: never ship keys, run dirs or build output.
launch-runs/
.staging-runs/
.preview/
**/target/
*.log
public/
frontend/*
!frontend/src/
frontend/src/*
!frontend/src/chain/
**/node_modules/
**/dist/
**/faucet-state.json*
# Secrets: the filled-in hosting env and any key files never enter the build context.
**/.env
**/.env.*
!**/*.env.example
**/keys/
*.pem
