{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/indexer/:path*", "destination": "http://159.223.165.194:8091/:path*" },
    { "source": "/faucet/:path*", "destination": "http://159.223.165.194:8092/:path*" },
    { "source": "/((?!indexer/|faucet/).*)", "destination": "/index.html" }
  ]
}
