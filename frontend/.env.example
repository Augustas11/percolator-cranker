# Default is the deterministic mock. Use devnet for an injected Phantom/Solflare wallet.
VITE_MARKET_CLIENT=devnet
# Read-only indexer URL; "none" disables indexer panels.
# VITE_INDEXER_URL=http://127.0.0.1:8090
# Compute price feed (flop-feed output) for /compute; "none" disables it. Default /compute-feed.
# VITE_COMPUTE_FEED_URL=/compute-feed
# Optional overrides (defaults below: the COMPUTE-PERP market):
# VITE_RPC_URL=https://api.devnet.solana.com
# VITE_PROGRAM_ID=GaXu3DXKYcMs8WmZsgfWcHXQSDva2qe7Aguvn3YHKSHS
# VITE_MARKET=c2niKk33fXp5E8a7ZYzQXdqjEXizrSBb55VEuBQiNUU
