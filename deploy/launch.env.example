# deploy/.env (docker compose) or /etc/percolator/launch.env (systemd).
# Secrets: keep the filled-in copy 0600 and out of git.
LAUNCH_CLUSTER=devnet
LAUNCH_RPC_URL=https://YOUR-PAID-RPC.example/?api-key=...
PERCOLATOR_PROGRAM_ID=
LAUNCH_RUN_DIR=/var/lib/percolator-launch
# Owner of LAUNCH_RUN_DIR (its keys are 0600): `id -u` / `id -g` of that user.
LAUNCH_UID=
LAUNCH_GID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
