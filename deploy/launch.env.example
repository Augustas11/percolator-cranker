# deploy/.env (docker compose) or /etc/percolator/launch.env (systemd).
# Secrets: keep the filled-in copy 0600 and out of git.
LAUNCH_CLUSTER=devnet
LAUNCH_RPC_URL=https://YOUR-PAID-RPC.example/?api-key=...
PERCOLATOR_PROGRAM_ID=
LAUNCH_RUN_DIR=/var/lib/percolator-launch
# Owner of LAUNCH_RUN_DIR (its keys are 0600): `id -u` / `id -g` of that user.
LAUNCH_UID=
LAUNCH_GID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Mainnet only, after the handover: 1 lets the bots start (default 0).
LAUNCH_MAINNET_I_UNDERSTAND=0

# Devnet test-USDC faucet (deploy/docker-compose.yml `faucet`). The payer
# keypair is the test mint's authority; FAUCET_PUBLIC_PORT=0.0.0.0:8092 opens
# the nginx front to the Vercel /faucet rewrite.
FAUCET_PAYER_KEYPAIR=
FAUCET_DATA_DIR=
FAUCET_PUBLIC_PORT=127.0.0.1:8092
