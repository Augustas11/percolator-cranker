FROM node:22-bookworm-slim AS build
WORKDIR /src
COPY frontend/src/chain frontend/src/chain
COPY faucet faucet
WORKDIR /src/faucet
RUN npm ci && npm run build && npm prune --omit=dev

FROM node:22-bookworm-slim
COPY --from=build /src/faucet/node_modules /app/node_modules
COPY --from=build /src/faucet/dist /app/dist
# Preserve ESM for the bundled .js entry point.
COPY --from=build /src/faucet/package.json /app/package.json
USER 10001
WORKDIR /data
CMD ["node", "/app/dist/faucet.js"]
