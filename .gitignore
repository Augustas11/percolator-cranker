# --- Rust build artifacts ---
target/
**/target/
# Cargo.lock IS committed for the client + cranker binaries (reproducible builds).

# --- Solana local ledger + tooling scratch ---
.solana-test-ledger/
/tmp/solana-test-validator.*

# --- Upstream clones (not ours to redistribute) ---
# aeyakovenko/percolator + aeyakovenko/percolator-prog live at these paths locally.
# The engine is pinned by git rev in client/Cargo.toml and cranker/Cargo.toml.
# The wrapper is a PATH dependency: its SHA lives in scripts/pins.env,
# scripts/fetch_upstream.sh checks it out, and both crates' build.rs fail the
# build if repo-prog/ is at a different commit.
/repo/
/repo-prog/

# --- OS junk ---
.DS_Store
._*
Thumbs.db

# --- editor ---
.idea/
.vscode/
*.swp
*.swo

# --- session scratch ---
*.log

# --- Step B pre-merge preview worktrees + crate copy (scripts/preview_launch_fixes.sh) ---
/.preview/

# --- R2 local staging runs (scripts/staging_local.sh): ledger, logs, generated payer key ---
/.staging-runs/

# --- Day-0 launch runs (scripts/launch_market.sh, day0_drill.sh): state, generated keys, logs ---
/launch-runs/
/deploy/.env
