PERCOLATOR_PROG_SHA=6b27a826996726b75727b0b448dca2e51caab7a5
PERCOLATOR_ENGINE_REPO=https://github.com/aeyakovenko/percolator
PERCOLATOR_ENGINE_REV=b22bef7d6122fd7d82680ce9859e8b77fd8ef656
